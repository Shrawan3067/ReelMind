# ==============================================================================
# ReelMind Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on your EC2 instance before starting:
#   cp .env.production.example .env.production
#
# Generate secure keys via openssl:
#   JWT Secrets:   openssl rand -base64 32
#   Encryption:    openssl rand -hex 32
# ==============================================================================

# Core Service Configuration
PORT=5001
NODE_ENV=production

# Public URL of your deployed application
# Set to your EC2 public IPv4 (e.g., http://54.210.45.123) or custom domain (e.g., https://reelmind.yourdomain.com)
CLIENT_URL=http://localhost

# Database Connection (uses internal Docker service name)
MONGODB_URI=mongodb://mongo:27017/reelmind

# Authentication Secrets
# NOTE: Production will fail to boot if these contain default development values!
# Generate using: openssl rand -base64 32
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (Must be EXACTLY 64 hexadecimal characters)
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_openssl_rand_hex_32

# AI Provider Integration (Options: openai | gemini | anthropic | ollama | none)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
AI_BASE_URL=

# Media Storage and Processing Limits
UPLOAD_DIRECTORY=/app/uploads
THUMBNAIL_DIRECTORY=/app/thumbnails
MAX_UPLOAD_SIZE=524288000
MAX_CONCURRENT_JOBS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VECTOR_SEARCH_MODE=local
ATLAS_VECTOR_INDEX=scene_embedding_index

# UGREEN AI NAS Integration
NAS_PROVIDER=ugreen_ugos
NAS_BASE_URL=
NAS_CONNECTION_MODE=disconnected
