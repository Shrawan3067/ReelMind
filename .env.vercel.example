# ==============================================================================
# ReelMind — Vercel Environment Variables Template
# Add these in your Vercel Project Settings > Environment Variables
# ==============================================================================

NODE_ENV=production

# Remote MongoDB Connection (e.g. MongoDB Atlas cluster)
# Required: Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (anywhere)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reelmind?retryWrites=true&w=majority

# Authentication Secrets (generate via: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (Must be EXACTLY 64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_CHAR_HEX_KEY

# AI Provider Configuration (Options: openai | gemini | anthropic | ollama | none)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
AI_BASE_URL=

# Media Storage and Processing
MAX_UPLOAD_SIZE=524288000
MAX_CONCURRENT_JOBS=2
VECTOR_SEARCH_MODE=local
ATLAS_VECTOR_INDEX=scene_embedding_index

# UGREEN AI NAS Integration
NAS_PROVIDER=ugreen_ugos
NAS_BASE_URL=
NAS_CONNECTION_MODE=disconnected
