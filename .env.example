# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/reelmind

# Authentication & Security
JWT_ACCESS_SECRET=change-me-to-a-secure-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-secure-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Provider Configuration
# Options: openai | gemini | anthropic | ollama | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
AI_BASE_URL=

# Media & Processing
UPLOAD_DIRECTORY=./uploads
THUMBNAIL_DIRECTORY=./thumbnails
MAX_UPLOAD_SIZE=524288000
MAX_CONCURRENT_JOBS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VECTOR_SEARCH_MODE=local
ATLAS_VECTOR_INDEX=scene_embedding_index

# UGREEN NAS Integration
NAS_PROVIDER=ugreen_ugos
NAS_BASE_URL=
NAS_CONNECTION_MODE=disconnected

